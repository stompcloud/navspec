{
  "name": "navspec",
  "version": "0.1.0",
  "description": "A small compiler for declarative application navigation specifications.",
  "type": "module",
  "bin": {
    "navspec": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run build && vitest run",
    "test:expo-ui": "npm run build && node scripts/validate-expo-router-ui.mjs",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "playwright": "^1.63.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  },
  "license": "MIT-0"
}
